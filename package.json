{
    "name": "@rymi/node",
    "version": "1.0.1",
    "description": "The official Node.js REST API wrapper for Rymi.",
    "license": "MIT",
    "author": "Rymi AI <engineering@rymi.live>",
    "homepage": "https://rymi.live",
    "keywords": [
        "voice-ai",
        "voice-agent",
        "ai-agents",
        "text-to-speech",
        "speech-to-text",
        "telephony",
        "rymi"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rymi-live/rymi-node.git"
    },
    "bugs": {
        "url": "https://github.com/rymi-live/rymi-node/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@rymi/sdk-types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^1.0.0"
    }
}
